# ─────────────────────────────────────────────────────────────────────────────
# Multimodal Clinical AI Copilot — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER put real credentials in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# ── HuggingFace ───────────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=hf_your_token_here

# ── Ollama (local development) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=llava:7b
REASONING_MODEL=mistral:7b

# ── Qdrant Collections ────────────────────────────────────────────────────────
QDRANT_XRAY_COLLECTION=xray_embeddings
QDRANT_NOTES_COLLECTION=clinical_notes
QDRANT_LITERATURE_COLLECTION=medical_literature

# ── Embedding Models ──────────────────────────────────────────────────────────
PUBMEDBERT_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=openai

# ── Data Paths ────────────────────────────────────────────────────────────────
OPENI_DATA_DIR=data/openi
LITERATURE_DATA_DIR=data/literature
PDF_OUTPUT_DIR=data/pdfs

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ── Ingestion Settings ────────────────────────────────────────────────────────
OPENI_BATCH_SIZE=32
RAG_TOP_K=5
IMAGE_MAX_SIZE_MB=10

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
