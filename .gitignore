# ─────────────────────────────────────────────────────────────────────────────
# Clinical AI Copilot — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual Environment ───────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Environment Variables (NEVER commit secrets!) ────────────────────────────
.env
.env.local
.env.production
*.env

# ── Data Files (large binary/data files) ─────────────────────────────────────
backend/data/openi/images/
backend/data/pdfs/
backend/data/literature/
# Keep the sample reports directory but not images
!backend/data/openi/reports/

# ── Model Caches ─────────────────────────────────────────────────────────────
*.pkl
*.pt
*.pth
*.bin
*.safetensors
.cache/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Pytest ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.bak
Intial doc.txt
