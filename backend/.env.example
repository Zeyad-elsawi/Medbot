# ─────────────────────────────────────────────────────────────────────────────
# Multimodal Clinical AI Copilot — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────────────────────

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://YOUR_CLUSTER_ID.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── HuggingFace (for embedding models download) ───────────────────────────────
HUGGINGFACE_TOKEN=hf_your_token_here

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free Tier: 15 requests/min, 1,500 requests/day
GOOGLE_API_KEY=your-gemini-api-key

# ── Model Selection (Optional — defaults shown) ───────────────────────────────
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_REASONING_MODEL=gemini-1.5-flash

# ── CORS (set to your Vercel URL after deploying frontend) ───────────────────
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
